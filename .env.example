# Copy to .env.local and fill in, or run `vercel env pull .env.local --yes`
# after provisioning the Neon and Clerk marketplace integrations.

# --- Database (Neon) -------------------------------------------------------
# Use the POOLED connection string (host contains "-pooler") for serverless.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/shelf?sslmode=require

# --- Auth (Clerk) ----------------------------------------------------------
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- API wiring ------------------------------------------------------------
# Where the Next.js app forwards /api/* . Locally this is the Go server.
SHELF_API_URL=http://localhost:8080

# Shared secret guarding /cron/* endpoints on the Go API.
CRON_SECRET=change-me-to-a-long-random-string

# Port the Go API listens on locally.
PORT=8080
